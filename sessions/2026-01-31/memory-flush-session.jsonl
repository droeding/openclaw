 *)\n            echo \"Abgebrochen.\"\n            exit 0\n            ;;\n    esac\nfi\n\n# Create new session\necho -e \"${GREEN}[✓] Erstelle PACT Session: $SESSION_NAME${NC}\"\n\n# Window 0: Orchestrator\ntmux new-session -d -s \"$SESSION_NAME\" -n \"orchestrator\"\ntmux send-keys -t \"$SESSION_NAME:orchestrator\" \"cd $(pwd)\" C-m\ntmux send-keys -t \"$SESSION_NAME:orchestrator\" \"echo '🎯 PACT Orchestrator - Projekt: $PROJECT_NAME'\" C-m\ntmux send-keys -t \"$SESSION_NAME:orchestrator\" \"echo 'Befehle: ./send-claude-message.sh <window> <message>'\" C-m\n\n# Window 1: PM/Architect (Strategy - Cloud)\ntmux new-window -t \"$SESSION_NAME\" -n \"pm-arch\"\ntmux send-keys -t \"$SESSION_NAME:pm-arch\" \"cd $(pwd)\" C-m\ntmux send-keys -t \"$SESSION_NAME:pm-arch\" \"echo '📋 PM/Architect Window (Claude Opus)'\" C-m\ntmux send-keys -t \"$SESSION_NAME:pm-arch\" \"echo 'Nutze: claude für Planung und Architektur'\" C-m\n\n# Window 2: Dev/QA (Execution - Hybrid)\ntmux new-window -t \"$SESSION_NAME\" -n \"dev-qa\"\ntmux send-keys -t \"$SESSION_NAME:dev-qa\" \"cd $(pwd)\" C-m\ntmux send-keys -t \"$SESSION_NAME:dev-qa\" \"echo '💻 Dev/QA Window'\" C-m\ntmux send-keys -t \"$SESSION_NAME:dev-qa\" \"echo 'Nutze: claude oder aider für Implementation'\" C-m\n\n# Window 3: Logs/Monitor\ntmux new-window -t \"$SESSION_NAME\" -n \"monitor\"\ntmux send-keys -t \"$SESSION_NAME:monitor\" \"cd $(pwd)\" C-m\ntmux send-keys -t \"$SESSION_NAME:monitor\" \"echo '📊 Monitor Window'\" C-m\ntmux send-keys -t \"$SESSION_NAME:monitor\" \"echo 'Logs und Status hier'\" C-m\n\n# Select first window\ntmux select-window -t \"$SESSION_NAME:orchestrator\"\n\necho \"\"\necho -e \"${GREEN}═══════════════════════════════════════════${NC}\"\necho -e \"${GREEN}  PACT Session gestartet!${NC}\"\necho -e \"${GREEN}═══════════════════════════════════════════${NC}\"\necho \"\"\necho \"  Windows:\"\necho \"    0: orchestrator  - Steuerung\"\necho \"    1: pm-arch       - PM & Architekt (Claude)\"\necho \"    2: dev-qa        - Developer & QA\"\necho \"    3: monitor       - Logs\"\necho \"\"\necho \"  Befehle:\"\necho \"    tmux attach -t $SESSION_NAME\"\necho \"    Ctrl+b, n/p     - Zwischen Windows wechseln\"\necho \"    Ctrl+b, d       - Detach (Session läuft weiter)\"\necho \"\"\n\n# Attach to session\nread -p \"Jetzt zur Session wechseln? [Y/n]: \" attach\nif [[ ! \"$attach\" =~ ^[Nn]$ ]]; then\n    tmux attach-session -t \"$SESSION_NAME\"\nfi\n"}},{"type":"toolCall","id":"toolu_01W47NvTqhKaHAaSkmkxTUWr","name":"write","arguments":{"path":"/home/demo/projects/pact-core/scripts/send-claude-message.sh","content":"#!/bin/bash\n#===============================================================================\n# PACT Intercom - Sendet Nachrichten zwischen Agent-Windows\n#===============================================================================\n\n# Colors\nRED='\\033[0;31m'\nGREEN='\\033[0;32m'\nYELLOW='\\033[1;33m'\nNC='\\033[0m'\n\nusage() {\n    echo \"PACT Intercom - Agent-zu-Agent Kommunikation\"\n    echo \"\"\n    echo \"Usage: $0 <target-window> <message>\"\n    echo \"\"\n    echo \"Windows:\"\n    echo \"  orchestrator  - Orchestrator/Steuerung\"\n    echo \"  pm-arch       - PM & Architekt\"\n    echo \"  dev-qa        - Developer & QA\"\n    echo \"  monitor       - Monitor/Logs\"\n    echo \"\"\n    echo \"Beispiele:\"\n    echo \"  $0 dev-qa 'Implementiere Story #1: User Login'\"\n    echo \"  $0 pm-arch 'Review benötigt für Architektur-Entscheidung'\"\n    echo \"\"\n    exit 1\n}\n\nif [ $# -lt 2 ]; then\n    usage\nfi\n\nTARGET_WINDOW=\"$1\"\nshift\nMESSAGE=\"$*\"\n\n# Find PACT session\nSESSION=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^pact-' | head -1)\n\nif [ -z \"$SESSION\" ]; then\n    echo -e \"${RED}[✗] Keine PACT Session gefunden!${NC}\"\n    echo \"    Starte zuerst: ./start_pact.sh\"\n    exit 1\nfi\n\n# Validate target window\nif ! tmux list-windows -t \"$SESSION\" -F '#{window_name}' | grep -q \"^${TARGET_WINDOW}$\"; then\n    echo -e \"${RED}[✗] Window '$TARGET_WINDOW' nicht gefunden!${NC}\"\n    echo \"\"\n    echo \"Verfügbare Windows:\"\n    tmux list-windows -t \"$SESSION\" -F '  #{window_name}'\n    exit 1\nfi\n\n# Send message\nTIMESTAMP=$(date +\"%H:%M:%S\")\nFORMATTED_MESSAGE=\"\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n📨 INTERCOM [$TIMESTAMP]\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n$MESSAGE\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\"\n\n# Send to target window\ntmux send-keys -t \"$SESSION:$TARGET_WINDOW\" \"echo '$FORMATTED_MESSAGE'\" C-m\n\necho -e \"${GREEN}[✓] Nachricht gesendet an $TARGET_WINDOW${NC}\"\n\n# Optional: Also send as input to Claude if running\n# This could be extended to interact with a running Claude session\n"}},{"type":"toolCall","id":"toolu_014QM4w54UqvhpfBbP2UvfRB","name":"exec","arguments":{"command":"chmod +x /home/demo/projects/pact-core/pact-setup.sh /home/demo/projects/pact-core/scripts/*.sh"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-opus-4-5","usage":{"input":8,"output":2427,"cacheRead":137872,"cacheWrite":4486,"totalTokens":144793,"cost":{"input":0.00004,"output":0.060675,"cacheRead":0.068936,"cacheWrite":0.0280375,"total":0.15768849999999998}},"stopReason":"toolUse","timestamp":1769866121868}}
