{"type":"message","id":"c282f6d1","parentId":"6d43385b","timestamp":"2026-01-31T06:57:16.720Z","message":{"role":"toolResult","toolCallId":"toolu_01BPGXCJq3oCWf2K8cosqBRi","toolName":"read","content":[{"type":"text","text":"from __future__ import annotations\n\nimport asyncio\nimport logging\nimport shutil\nimport subprocess\nimport tempfile\nimport wave\nfrom pathlib import Path\nfrom typing import Any, Optional\n\nimport numpy as np\n\nfrom piper.config import SynthesisConfig\nfrom piper.voice import PiperVoice\n\nfrom .base import BaseTTS, TTSResult\n\nlogger = logging.getLogger(__name__)\n\n\nclass ThorstenTTS(BaseTTS):\n    \"\"\"Thorsten-Stimme mit konfigurierbarem Backend (ONNX oder Piper CLI).\"\"\"\n\n    name = \"thorsten\"\n\n    def __init__(\n        self,\n        *,\n        model_path: str,\n        speaker_id: Optional[int] = None,\n        sample_rate: int = 22050,\n        num_channels: int = 1,\n        use_cpu: bool = False,\n        backend: str = \"onnx\",\n        **options: Any,\n    ) -> None:\n        super().__init__(sample_rate=sample_rate, num_channels=num_channels, **options)\n        backend = (backend or \"onnx\").lower()\n        if backend not in {\"onnx\", \"cli\"}:\n            raise ValueError(\"Unsupported Thorsten backend '%s'.\" % backend)\n\n        if backend == \"cli\":\n            self._impl = _ThorstenPiperCliBackend(\n                model_path=model_path,\n                speaker_id=speaker_id,\n                sample_rate=sample_rate,\n                num_channels=num_channels,\n                options=options,\n            )\n        else:\n            self._impl = _ThorstenOnnxBackend(\n                model_path=model_path,\n                speaker_id=speaker_id,\n                sample_rate=sample_rate,\n                num_channels=num_channels,\n                use_cpu=use_cpu,\n                options=options,\n            )\n\n    async def synthesize(self, text: str) -> TTSResult:\n        return await self._impl.synthesize(text)\n\n    def shutdown(self) -> None:\n        self._impl.shutdown()\n\n\nclass _ThorstenOnnxBackend:\n    def __init__(\n        self,\n        *,\n        model_path: str,\n        speaker_id: Optional[int],\n        sample_rate: int,\n        num_channels: int,\n        use_cpu: bool,\n        options: dict[str, Any],\n    ) -> None:\n        path = Path(model_path)\n        if not path.exists():\n            raise FileNotFoundError(f\"Thorsten-Modell nicht gefunden: {path}\")\n\n        config_path = options.get(\"config_path\") or f\"{model_path}.json\"\n        config_path = Path(config_path)\n        if not config_path.exists():\n            raise FileNotFoundError(f\"Thorsten-Konfigurationsdatei nicht gefunden: {config_path}\")\n\n        self._sample_rate = sample_rate\n        self._num_channels = num_channels\n        self._speaker_id = speaker_id\n        self._use_cuda = not use_cpu\n\n        try:\n            self._voice = PiperVoice.load(\n                model_path=path,\n                config_path=config_path,\n                use_cuda=self._use_cuda,\n            )\n            logger.info(\n                \"Initialised Thorsten TTS (backend=onnx, cuda=%s, speaker_id=%s, sample_rate=%s)\",\n                self._use_cuda,\n                self._speaker_id,\n                self._sample_rate,\n            )\n        except Exception as exc:\n            if self._use_cuda:\n                logger.warning(\n                    \"Thorsten TTS failed to initialise with CUDA (%s). Retrying on CPU.\",\n                    exc,\n                )\n                self._voice = PiperVoice.load(\n                    model_path=path,\n                    config_path=config_path,\n                    use_cuda=False,\n                )\n                self._use_cuda = False\n                logger.info(\"Thorsten TTS successfully initialised on CPU.\")\n            else:\n                logger.exception(\"Thorsten TTS could not be initialised: %s\", exc)\n                raise RuntimeError(f\"Thorsten-Modell konnte nicht geladen werden: {exc}\") from exc\n\n    async def synthesize(self, text: str) -> TTSResult:\n        text = text.strip()\n        if not text:\n            return TTSResult(\n                audio=np.zeros(int(self._sample_rate * 0.25), dtype=np.float32),\n                sample_rate=self._sample_rate,\n                num_channels=self._num_channels,\n            )\n\n        syn_cfg = SynthesisConfig(\n            speaker_id=self._speaker_id,\n            length_scale=None,\n            noise_scale=None,\n            noise_w_scale=None,\n            volume=1.0,\n            normalize_audio=True,\n        )\n\n        chunks = list(self._voice.synthesize(text, syn_config=syn_cfg))\n        if not chunks:\n            audio = np.zeros(1, dtype=np.float32)\n            sr = self._sample_rate\n        else:\n            audio = np.concatenate([chunk.audio_float_array for chunk in chunks])\n            sr = chunks[0].sample_rate\n\n        audio = np.clip(audio, -1.0, 1.0).astype(np.float32)\n        return TTSResult(audio=audio, sample_rate=sr, num_channels=self._num_channels)\n\n    def shutdown(self) -> None:\n        self._voice = None  # type: ignore[assignment]\n\n\nclass _ThorstenPiperCliBackend:\n    \"\"\"Wrapper around the Piper CLI binary.\"\"\"\n\n    def __init__(\n        self,\n        *,\n        model_path: str,\n        speaker_id: Optional[int],\n        sample_rate: int,\n        num_channels: int,\n        options: dict[str, Any],\n    ) -> None:\n        self._sample_rate = sample_rate\n        self._num_channels = num_channels\n        self._speaker_id = speaker_id\n\n        model = Path(model_path)\n        if not model.exists():\n            raise FileNotFoundError(f\"Thorsten-Modell nicht gefunden: {model}\")\n        self._model_path = model\n\n        configured_bin = options.get(\"piper_bin\")\n        bin_path = configured_bin or shutil.which(\"piper\")\n        if not bin_path:\n            raise FileNotFoundError(\n                \"Piper CLI wurde nicht gefunden. Installiere `piper` und/oder setze `piper_bin`.\"\n            )\n        self._piper_bin = Path(bin_path)\n\n        self._use_cuda = bool(options.get(\"use_cuda\"))\n        extra_args = options.get(\"cli_extra_args\")\n        if isinstance(extra_args, str):\n            self._extra_args = extra_args.split()\n        elif isinstance(extra_args, (list, tuple)):\n            self._extra_args = [str(arg) for arg in extra_args]\n        else:\n            self._extra_args = []\n\n        logger.info(\n            \"Initialised Thorsten TTS (backend=piper-cli, cuda=%s, speaker_id=%s, model=%s)\",\n            self._use_cuda,\n            self._speaker_id,\n            self._model_path,\n        )\n\n    async def synthesize(self, text: str) -> TTSResult:\n        text = text.strip()\n        if not text:\n            return TTSResult(\n                audio=np.zeros(int(self._sample_rate * 0.25), dtype=np.float32),\n                sample_rate=self._sample_rate,\n                num_channels=self._num_channels,\n            )\n\n        audio, sample_rate, channels = await asyncio.to_thread(self._invoke_cli, text)\n        return TTSResult(audio=audio, sample_rate=sample_rate, num_channels=channels)\n\n    def _invoke_cli(self, text: str) -> tuple[np.ndarray, int, int]:\n        with tempfile.NamedTemporaryFile(suffix=\".wav\", delete=False) as tmp_file:\n            tmp_path = Path(tmp_file.name)\n\n        try:\n            cmd = [\n                str(self._piper_bin),\n                \"--model\",\n                str(self._model_path),\n                \"--output_file\",\n                str(tmp_path),\n            ]\n            if self._speaker_id is not None:\n                cmd += [\"--speaker\", str(self._speaker_id)]\n            if self._use_cuda:\n                cmd.append(\"--cuda\")\n            if self._extra_args:\n                cmd.extend(self._extra_args)\n\n            logger.debug(\"Running Piper CLI: %s\", \" \".join(cmd))\n            completed = subprocess.run(\n                cmd,\n                input=text.encode(\"utf-8\"),\n                check=False,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n            )\n            if completed.returncode != 0:\n                stderr = completed.stderr.decode(\"utf-8\", errors=\"ignore\")\n                raise RuntimeError(f\"Piper CLI failed with exit code {completed.returncode}: {stderr}\")\n\n            with wave.open(str(tmp_path), \"rb\") as wav_file:\n                sample_rate = wav_file.getframerate()\n                num_channels = wav_file.getnchannels()\n                frames = wav_file.readframes(wav_file.getnframes())\n\n            audio = np.frombuffer(frames, dtype=np.int16).astype(np.float32) / 32767.0\n            if num_channels > 1:\n                audio = audio.reshape(-1, num_channels).mean(axis=1)\n                num_channels = 1\n\n            return audio.astype(np.float32), sample_rate, num_channels\n        finally:\n            try:\n                tmp_path.unlink(missing_ok=True)\n            except Exception:\n                logger.debug(\"Failed to delete temporary Piper output: %s\", tmp_path)\n\n    def shutdown(self) -> None:\n        return None\n"}],"isError":false,"timestamp":1769842636711}}
